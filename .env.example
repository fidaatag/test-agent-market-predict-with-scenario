# --- 9router (OpenAI-compatible proxy) ---
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=sk-no-key-needed

# --- Model SUTRADARA (orkestrator) — pilih yang murah & cepat, harus rapi soal JSON ---
DIRECTOR_MODEL=ds/deepseek-chat

# --- Model default untuk AGENT (tokoh pasar) ---
AGENT_MODEL=ds/deepseek-chat

# --- Fallback kalau model utama kena rate-limit (429) / error. Pisahkan dengan koma ---
FALLBACK_MODELS=ds/deepseek-v4-flash,ds/deepseek-reasoner

# --- Nama tampilanmu saat nyelonong sebagai manusia ---
HUMAN_NAME=Kamu

# --- Anti-loop: maksimal giliran agent beruntun sebelum dipaksa berhenti ---
MAX_AGENT_STREAK=4

# --- Setelah manusia bicara, lanjutkan pasar otomatis sampai n beat atau sampai sepi ---
AUTO_CHAIN_BEATS=4

# CATATAN: ID model mengikuti alias yang muncul di endpoint 9router lokal.
# Cek daftar model aktif dengan: curl http://localhost:20128/v1/models
